# UCC-CoDE eServices runtime
PORT=3000
STORAGE_DIR=./storage
PUBLIC_BASE_URL=https://mycode360.app

# Developer administration - replace every default before production
DEVELOPER_ADMIN_USER=developer
DEVELOPER_ADMIN_PASSWORD=replace-with-a-long-random-password
EDUCATION_ADMIN_USER=education-admin
EDUCATION_ADMIN_PASSWORD=replace-with-a-long-random-password
BUSINESS_ADMIN_USER=business-admin
BUSINESS_ADMIN_PASSWORD=replace-with-a-long-random-password
ARTS_SOCIAL_ADMIN_USER=arts-admin
ARTS_SOCIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
SCIENCE_MATH_ADMIN_USER=science-admin
SCIENCE_MATH_ADMIN_PASSWORD=replace-with-a-long-random-password

# Gmail API notifications
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_FROM_NAME=CoDE eServices Portal

# Arkesel Student Support SMS notifications. Keep disabled until the sender ID is approved and tested.
SUPPORT_SMS_ENABLED=false
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=UCC-CoDE
ARKESEL_CALLBACK_SECRET=replace-with-a-separate-long-random-secret

# Student Support Services
SUPPORT_STATUS_TOKEN_SECRET=replace-with-a-separate-long-random-secret
SUPPORT_ALLOWED_EMAIL_DOMAINS=ucc.edu.gh
SUPPORT_HOLIDAYS=
SUPPORT_EVIDENCE_REMINDER_WORKING_DAYS=3
SUPPORT_FORWARD_EXPIRY_DAYS=14
# SUPPORT_DB_FILE defaults to STORAGE_DIR/data/support-tickets.sqlite

# Other portal controls
ASSIGNMENT_EXPIRY_DAYS=14
ADMIN_INVITATION_EXPIRY_HOURS=24
STUDENT_FEEDBACK_EXPIRY_DAYS=30
PROJECT_HIGH_ROW_WARNING=100
CLAIM_CERTIFICATION_EXPIRY_DAYS=7
